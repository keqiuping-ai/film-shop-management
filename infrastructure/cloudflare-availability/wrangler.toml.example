name = "quad-availability-monitor"
main = "worker.js"
compatibility_date = "2026-11-17"

[triggers]
crons = ["* * * * *"]

[vars]
PRIMARY_HEALTH_URL = "https://film-shop-management-production.up.railway.app/api/health"

# Create a KV namespace and replace this value before deployment.
[[kv_namespaces]]
binding = "HEALTH_STATE"
id = "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"

# Store the alert endpoint as a Worker secret, never in this file:
# npx wrangler secret put ALERT_WEBHOOK_URL
# Then route backup.quadfilmus.com/* to this Worker.
